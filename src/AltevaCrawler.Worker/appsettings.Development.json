{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Crawler": {
    // Local development behind a TLS-inspecting proxy (e.g. NetFree) fails with "PartialChain" certificate errors.
    // Development only: production keeps the default (false) so invalid certificates are reported, not trusted.
    "AllowInvalidCertificates": true
  }
}
